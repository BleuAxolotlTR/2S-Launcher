<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Alt 3D gölge katmanı -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#40000000" />
            <corners android:radius="@dimen/slot_corner_radius" />
        </shape>
    </item>
    <!-- Üst 3DS kartuş yuvası katmanı -->
    <item android:bottom="2dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurfaceContainerHigh" />
            <stroke
                android:width="@dimen/slot_border_width"
                android:color="?attr/colorPrimary" />
            <corners android:radius="@dimen/slot_corner_radius" />
        </shape>
    </item>
</layer-list>
