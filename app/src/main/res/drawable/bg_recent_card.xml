<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 3D Dış Gölge -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#70000000" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Kartuş / Kart Gövdesi -->
    <item android:top="2dp" android:bottom="4dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#40FFFFFF"
                android:endColor="#20FFFFFF" />
            <stroke
                android:width="1.5dp"
                android:color="#99FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
