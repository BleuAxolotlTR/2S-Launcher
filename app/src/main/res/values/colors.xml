    <color name="primary_dark">#121212</color>
    <color name="accent">#00D2FF</color>
    <color name="accent_gold">#FFD700</color>
    <color name="bg_default">#121212</color>
    <color name="btn_color_top">#4A4A4A</color>
    <color name="btn_color_bottom">#2A2A2A</color>
    <color name="btn_confirm_top">#00A8FF</color>
    <color name="btn_confirm_bottom">#0066CC</color>
    <color name="btn_wallpaper_top">#4A4A4A</color>
    <color name="btn_wallpaper_bottom">#2A2A2A</color>
</resources>
