<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Base static colors used as fallbacks / overlays.
        Dynamic Color from system wallpaper overrides colorPrimary etc. at runtime via Material3.
    -->

    <!-- Overlay tints (semi-transparent — used directly in drawables/layouts) -->
    <color name="bg_essentials">#1AFFFFFF</color>
    <color name="bg_others_frame">#26FFFFFF</color>
    <color name="bg_others_inner">#22000000</color>

    <!-- Essentials slot colors -->
    <color name="slot_border">#88FFFFFF</color>
    <color name="slot_border_highlight">#FFFFFFFF</color>
    <color name="slot_border_shadow">#44000000</color>
    <color name="slot_empty_bg">#20FFFFFF</color>
    <color name="slot_filled_bg">#38FFFFFF</color>
    <color name="slot_selected_glow">#CCFFD000</color>
    <color name="slot_drag_highlight">#8800D2FF</color>

    <!-- Text colors -->
    <color name="text_primary">#FFFFFFFF</color>
    <color name="text_secondary">#CCECEFF1</color>
    <color name="text_hint">#88FFFFFF</color>
    <color name="text_retro_gold">#FFFFE066</color>

    <!-- Divider & badges -->
    <color name="divider">#44FFFFFF</color>
    <color name="badge_bg">#44000000</color>
    <color name="badge_border">#66FFFFFF</color>

    <!-- Utility -->
    <color name="white">#FFFFFFFF</color>
