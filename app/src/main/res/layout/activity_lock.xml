<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lockRootBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    android:background="@color/bg_default">

    <!-- Ana 2'ye Bölünmüş Düzen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ==================== ÜST BÖLÜM: SAAT & KUTU ==================== -->
        <FrameLayout
            android:id="@+id/lockTopContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="true">

            <!-- Duvar Kağıdı (Arka Plan) -->
            <ImageView
                android:id="@+id/lockWallpaper"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#33000000" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">

                <!-- Durum Çubuğu Boşluk Tutucusu -->
                <View
                    android:id="@+id/lockStatusBarSpacer"
                    android:layout_width="match_parent"
                    android:layout_height="48dp" />

                <!-- Büyük Retro Dijital Saat -->
                <TextClock
                    android:id="@+id/lockClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="hh:mm"
                    android:format24Hour="HH:mm"
                    android:textColor="@color/white"
                    android:textSize="54sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="4"
                    android:shadowRadius="8" />

                <!-- Tarih Rozeti -->
                <TextClock
                    android:id="@+id/lockDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="d MMMM, EEEE"
                    android:format24Hour="d MMMM, EEEE"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:letterSpacing="0.06"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="12dp" />

                <!-- Boş Köşeleri Yuvarlatılmış Dikdörtgen Kutu (PIN Göstergesi) -->
                <LinearLayout
                    android:id="@+id/pinBoxContainer"
                    android:layout_width="220dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_pin_box"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <View
                        android:id="@+id/dot0"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_pin_dot_empty" />

                    <View
                        android:id="@+id/dot1"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_pin_dot_empty" />

                    <View
                        android:id="@+id/dot2"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_pin_dot_empty" />

                    <View
                        android:id="@+id/dot3"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_pin_dot_empty" />
                </LinearLayout>

                <!-- Parmak İzi Hızlı Butonu & İpucu -->
                <LinearLayout
                    android:id="@+id/btnFingerprintQuick"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="8dp"
                    android:padding="4dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_fingerprint"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/tvLockHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Parmak izi veya PIN ile açın"
                        android:textColor="@color/accent"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </FrameLayout>

        <!-- 3DS Menteşe / Ayırıcı Çizgi -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/divider" />

        <!-- ==================== ALT BÖLÜM: TUŞ TAKIMI ==================== -->
        <LinearLayout
            android:id="@+id/lockBottomContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="@dimen/others_frame_margin_horizontal"
            android:paddingEnd="@dimen/others_frame_margin_horizontal"
            android:paddingTop="@dimen/others_frame_margin_vertical"
            android:paddingBottom="@dimen/others_frame_margin_vertical">

            <!-- 3DS Çerçeveli Dokunmatik Tuş Takımı Alanı -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_others_frame"
                android:padding="8dp">

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:stretchColumns="0,1,2">

                    <!-- Satır 1: 1 - 2 - 3 -->
                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <Button
                            android:id="@+id/btnKey1"
                            style="?android:attr/borderlessButtonStyle"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="3dp"
                            android:background="@drawable/bg_keypad_btn"
                            android:text="1"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnKey2"
                            style="?android:attr/borderlessButtonStyle"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="3dp"
                            android:background="@drawable/bg_keypad_btn"
                            android:text="2"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnKey3"
                            style="?android:attr/borderlessButtonStyle"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="3dp"
                            android:background="@drawable/bg_keypad_btn"
                            android:text="3"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </TableRow>

                    <!-- Satır 2: 4 - 5 - 6 -->
                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <Button
                            android:id="@+id/btnKey4"
                            style="?android:attr/borderlessButtonStyle"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="3dp"
                            android:background="@drawable/bg_keypad_btn"
                            android:text="4"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnKey5"
                            style="?android:attr/borderlessButtonStyle"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="3dp"
                            android:background="@drawable/bg_keypad_btn"
                            android:text="5"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnKey6"
                            style="?android:attr/borderlessButtonStyle"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="3dp"
                            android:background="@drawable/bg_keypad_btn"
                            android:text="6"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </TableRow>

                    <!-- Satır 3: 7 - 8 - 9 -->
                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <Button
                            android:id="@+id/btnKey7"
                            style="?android:attr/borderlessButtonStyle"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="3dp"
                            android:background="@drawable/bg_keypad_btn"
                            android:text="7"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnKey8"
                            style="?android:attr/borderlessButtonStyle"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="3dp"
                            android:background="@drawable/bg_keypad_btn"
                            android:text="8"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnKey9"
                            style="?android:attr/borderlessButtonStyle"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="3dp"
                            android:background="@drawable/bg_keypad_btn"
                            android:text="9"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </TableRow>

                    <!-- Satır 4: ⌫ - 0 - ✓ -->
                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <Button
                            android:id="@+id/btnKeyDelete"
                            style="?android:attr/borderlessButtonStyle"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="3dp"
                            android:background="@drawable/bg_keypad_btn"
                            android:text="⌫"
                            android:textColor="@color/btn_color_top"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnKey0"
                            style="?android:attr/borderlessButtonStyle"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="3dp"
                            android:background="@drawable/bg_keypad_btn"
                            android:text="0"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnKeyUnlock"
                            style="?android:attr/borderlessButtonStyle"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="3dp"
                            android:background="@drawable/bg_keypad_btn"
                            android:text="✓"
                            android:textColor="@color/btn_confirm_top"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                    </TableRow>

                </TableLayout>
            </FrameLayout>

        </LinearLayout>

    </LinearLayout>
</FrameLayout>
