<?xml version="1.0" encoding="utf-8"?>
<!--
    view_settings_strip.xml
    Shown directly below the Hidden Folder row in the Others RecyclerView.
    Matches the visual style of view_hidden_folder.xml.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="10dp">

    <!-- Settings row: gear icon + label -->
    <LinearLayout
        android:id="@+id/settingsRow"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_hidden_folder"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/settingsIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_settings"
            app:tint="?attr/colorOnSecondaryContainer"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/settingsLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="@string/settings"
            android:textColor="?attr/colorOnSecondaryContainer"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="?attr/colorOnSecondaryContainer"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />

    </LinearLayout>

</LinearLayout>
