<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/slot_size"
    android:layout_height="@dimen/slot_size"
    android:clickable="true"
    android:focusable="true">

    <!-- Empty slot view (clean translucent rounded square + subtle add icon) -->
    <FrameLayout
        android:id="@+id/slotEmptyContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_slot_empty"
        android:visibility="visible">

        <ImageView
            android:id="@+id/slotAddIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_add"
            android:alpha="0.45"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- Filled slot view (softly rounded squircle app icon) -->
    <FrameLayout
        android:id="@+id/slotFilledCard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <ImageView
            android:id="@+id/slotIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no" />
    </FrameLayout>

</FrameLayout>
